{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "FileTerm",
        "width": 1280,
        "height": 820,
        "minWidth": 1150,
        "minHeight": 790,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Remote terminal and file management workspace",
    "longDescription": "Connect to SSH, SFTP and FTP hosts from one multi-tab desktop workspace.",
    "copyright": "Copyright © 2026 St0ff3l",
    "license": "MIT",
    "publisher": "St0ff3l",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/applications/FileTerm.desktop": "linux/FileTerm.desktop",
          "/usr/share/applications/com.fileterm.desktop.desktop": "linux/com.fileterm.desktop.desktop",
          "/usr/share/metainfo/com.fileterm.desktop.metainfo.xml": "linux/com.fileterm.desktop.metainfo.xml",
          "/usr/share/pixmaps/com.fileterm.desktop.png": "icons/128x128.png",
          "/usr/share/pixmaps/fileterm.png": "icons/128x128.png",
          "/usr/share/licenses/file-term/LICENSE": "../../../LICENSE"
        }
      },
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": ["libssl3 | libssl3t64", "xdg-utils"],
        "files": {
          "/usr/share/applications/FileTerm.desktop": "linux/FileTerm.desktop",
          "/usr/share/applications/com.fileterm.desktop.desktop": "linux/com.fileterm.desktop.desktop",
          "/usr/share/metainfo/com.fileterm.desktop.metainfo.xml": "linux/com.fileterm.desktop.metainfo.xml",
          "/usr/share/pixmaps/com.fileterm.desktop.png": "icons/128x128.png",
          "/usr/share/pixmaps/fileterm.png": "icons/128x128.png",
          "/usr/share/licenses/file-term/LICENSE": "../../../LICENSE"
        }
      },
      "rpm": {
        "depends": [
          "xdg-utils",
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libayatana-appindicator3.so.1()(64bit)",
          "libssl.so.3()(64bit)",
          "libcrypto.so.3()(64bit)"
        ],
        "files": {
          "/usr/share/applications/FileTerm.desktop": "linux/FileTerm.desktop",
          "/usr/share/applications/com.fileterm.desktop.desktop": "linux/com.fileterm.desktop.desktop",
          "/usr/share/metainfo/com.fileterm.desktop.metainfo.xml": "linux/com.fileterm.desktop.metainfo.xml",
          "/usr/share/pixmaps/com.fileterm.desktop.png": "icons/128x128.png",
          "/usr/share/pixmaps/fileterm.png": "icons/128x128.png",
          "/usr/share/licenses/file-term/LICENSE": "../../../LICENSE"
        }
      }
    }
  }
}
